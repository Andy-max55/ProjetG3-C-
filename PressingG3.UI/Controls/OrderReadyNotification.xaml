<UserControl x:Class="PressingG3.UI.Controls.OrderReadyNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="350" Height="80"
             Background="Transparent">

    <Border x:Name="NotificationBorder"
            Background="#4CAF50"  
            CornerRadius="8"
            Padding="15"
            Opacity="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
		<Border.RenderTransform>
			<TranslateTransform Y="-100"/>
		</Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#4CAF50"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="✅" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <StackPanel VerticalAlignment="Center" Width="150">
                <TextBlock x:Name="TxtNotificationTitle" Text="Commande PRÊTE !" FontWeight="Bold" Foreground="White" FontSize="14"/>
                <TextBlock x:Name="TxtNotificationDetails" Text="Ticket N°T-000000 prêt à être envoyé." Foreground="White" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="BtnSendEmail" 
                    Content="✉️ ENVOYER MAIL" 
                    Click="BtnSendEmail_Click"
                    Width="100" 
                    Height="30"
                    Margin="10,0,0,0"
                    Background="White" 
                    Foreground="#4CAF50"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>
    </Border>

</UserControl>