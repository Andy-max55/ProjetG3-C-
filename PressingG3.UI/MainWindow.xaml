<Window x:Class="PressingG3.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PressingG3.UI.Controls"
        mc:Ignorable="d"
        Title="Pressing G3 - Gestion Professionnelle" 
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">

                <TextBlock Text="PRESSING G3" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,40"/>

                <Button Content="ACCUEIL / DASHBOARD" Height="45" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0" Cursor="Hand"/>

                <Button Content="+ NOUVEAU DÉPÔT" Click="BtnNewOrder_Click" Height="45" Margin="0,5" Background="#27AE60" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>

                <Button Content="RETRAIT &amp; PAIEMENT" Click="BtnPickup_Click" Height="45" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0" Cursor="Hand"/>

                <Button Content="GESTION CLIENTS" Click="BtnClients_Click" Height="45" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0" Cursor="Hand"/>

                <Button Content="HISTORIQUE COMMANDES" Click="BtnHistory_Click" Height="45" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0" Cursor="Hand"/>

                <Button Content="🛠️ OUVRIR ATELIER (TEST)" 
        Click="BtnTestProduction_Click" 
        Height="45" Margin="0,20,0,5" 
        Background="#E74C3C" Foreground="White" 
        BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tableau de bord" 
                       FontSize="28" 
                       FontWeight="SemiBold" 
                       Foreground="#34495E"
                       Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Bienvenue dans Pressing G3" FontSize="20" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sélectionnez une option dans le menu" FontSize="14" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
        <!-- NOTIFICATION (Ajouté manuellement) -->
        <controls:OrderReadyNotification x:Name="NotificationArea" 
                                         Grid.ColumnSpan="2" 
                                         HorizontalAlignment="Right" 
                                         VerticalAlignment="Top" 
                                         Margin="0,20,20,0"
                                         Visibility="Collapsed" 
                                         Panel.ZIndex="99"/>
    </Grid>
</Window>