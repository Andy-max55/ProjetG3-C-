<Window x:Class="PressingG3.UI.Views.PickupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retrait &amp; Paiement" Height="650" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="🔍 RECHERCHER UNE COMMANDE" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="35" VerticalContentAlignment="Center" Padding="5" 
         TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid x:Name="GridCommandes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionChanged="GridCommandes_SelectionChanged"
                      Background="White" BorderThickness="0" RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticket" Binding="{Binding NumeroTicket}" Width="120"/>
                    <DataGridTextColumn Header="Client" Binding="{Binding Client.NomComplet}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="100"/>
                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="100" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DÉTAILS DE LA COMMANDE" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <Separator Margin="0,10" Grid.Row="0" VerticalAlignment="Bottom"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock x:Name="LblClientNom" Text="Sélectionnez une commande..." FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTicketNum" Text="-" Foreground="Gray"/>
                </StackPanel>

                <ListView x:Name="ListDetails" Grid.Row="2" BorderThickness="0" Background="#F9F9F9">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Vêtement" Width="200" DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="État" Width="100" DisplayMemberBinding="{Binding Categorie}"/>
                            <GridViewColumn Header="Prix" Width="80" DisplayMemberBinding="{Binding Prix}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="3" Margin="0,20">
                    <Grid>
                        <TextBlock Text="MONTANT À REGLER :" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="LblTotal" Text="0 FCFA" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="BtnAction" Grid.Row="4" Content="ENCAISSER &amp; LIVRER (F12)" Click="BtnAction_Click"
                        IsEnabled="False"
                        Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                    </Button.Effect>
                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>