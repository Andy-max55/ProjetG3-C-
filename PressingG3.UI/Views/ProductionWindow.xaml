<Window x:Class="PressingG3.UI.Views.ProductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atelier de Production - Suivi des Travaux" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#2C3E50">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="5" Margin="0,0,0,10" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏭 ATELIER DE PRODUCTION" FontSize="20" FontWeight="Bold" Foreground="#34495E"/>
                    <TextBlock x:Name="LblUser" Text="Connecté en tant que Laveur" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <Button Content="Déconnexion" Click="BtnLogout_Click"
                        HorizontalAlignment="Right" Background="#E74C3C" Foreground="White" 
                        Padding="15,5" BorderThickness="0" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ECF0F1" CornerRadius="5" Margin="0,0,5,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#95A5A6" Height="40" CornerRadius="3">
                        <TextBlock Text="📥 À LAVER (En attente)" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="ListTodo" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="5" Margin="0,0,0,10" Padding="10" Width="350">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" Opacity="0.1"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NumeroTicket}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Client.NomComplet}" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Articles.Count, StringFormat='{}{0} Articles'}" Foreground="#3498DB" FontWeight="SemiBold" Margin="0,5"/>

                                        <Button Content="DÉMARRER LE LAVAGE ➡️" Tag="{Binding Id}" Click="BtnStart_Click"
                                                Margin="0,10,0,0" Background="#3498DB" Foreground="White" BorderThickness="0" Height="30"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#D5F5E3" CornerRadius="5" Margin="5,0,5,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#27AE60" Height="40" CornerRadius="3">
                        <TextBlock Text="⚙️ EN MACHINE / REPASSAGE" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="ListInProgress" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="5" Margin="0,0,0,10" Padding="10" Width="350">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" Opacity="0.1"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NumeroTicket}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Client.NomComplet}" Foreground="Gray"/>
                                        <TextBlock Text="Traitement en cours..." Foreground="#27AE60" FontStyle="Italic" Margin="0,5"/>

                                        <Button Content="TERMINER (METTRE SUR CINTRE) ✅" Tag="{Binding Id}" Click="BtnFinish_Click"
                                                Margin="0,10,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Height="30"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FCF3CF" CornerRadius="5" Margin="5,0,0,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F39C12" Height="40" CornerRadius="3">
                        <TextBlock Text="👔 PRÊT (Attend le client)" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="ListReady" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="5" Margin="0,0,0,10" Padding="10" Width="350">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" Opacity="0.1"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NumeroTicket}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Client.NomComplet}" Foreground="Gray"/>
                                        <TextBlock Text="{Binding DatePrevu, StringFormat='Prévu le : {0:dd/MM}'}" Foreground="#E67E22" Margin="0,5"/>
                                        <TextBlock Text="En attente de retrait..." FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>