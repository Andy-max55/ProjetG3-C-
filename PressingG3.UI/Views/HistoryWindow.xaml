<Window x:Class="PressingG3.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique Global des Commandes" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <WrapPanel VerticalAlignment="Center">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Du :" Foreground="Gray"/>
                    <DatePicker x:Name="DateDebut" Width="120" SelectedDateChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Au :" Foreground="Gray"/>
                    <DatePicker x:Name="DateFin" Width="120" SelectedDateChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Statut :" Foreground="Gray"/>
                    <ComboBox x:Name="CmbStatut" Width="150" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="TOUS" IsSelected="True"/>
                        <ComboBoxItem Content="En Lavage"/>
                        <ComboBoxItem Content="Prêt"/>
                        <ComboBoxItem Content="Livré / Payé"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="🔄 Actualiser" Click="BtnReset_Click"
                        Height="25" Padding="10,0" Margin="0,15,0,0"
                        Background="#ECF0F1" Foreground="Black" BorderThickness="0"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="GridHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" RowHeight="35" BorderThickness="0"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° Ticket" Binding="{Binding NumeroTicket}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client.NomComplet}" Width="200"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Client.Telephone}" Width="100"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding MontantTotal, StringFormat=N0}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <TextBlock Text="Sélectionnez une ligne pour réimprimer." VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic" Margin="0,0,20,0"/>

                <Button Content="🖨️ RÉIMPRIMER TICKET" Click="BtnReprint_Click"
                        Width="180" Height="40" Margin="0,0,10,0"
                        Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

                <Button Content="📄 RÉIMPRIMER FACTURE" Click="BtnReprintInvoice_Click"
                        Width="180" Height="40"
                        Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chiffre d'Affaires Période :" FontSize="14"/>
                <TextBlock x:Name="LblTotalPeriode" Text="0 FCFA" FontSize="16" FontWeight="Bold" Foreground="#27AE60" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>