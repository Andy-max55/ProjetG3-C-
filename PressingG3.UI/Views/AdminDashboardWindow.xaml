<Window x:Class="PressingG3.UI.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADMINISTRATION - PRESSING G3" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#C0392B">
			<Grid>
				<TextBlock Text="ESPACE ADMINISTRATION &amp; SUPERVISION"
                           Foreground="White" FontWeight="Bold" FontSize="18"
                           VerticalAlignment="Center" Margin="20,0"/>

				<Button Content="Quitter le mode Admin" Click="BtnQuit_Click"
                        HorizontalAlignment="Right" Margin="20,10" Padding="10,0"
                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="200"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<Button Content="VUE D'ENSEMBLE" Click="BtnRefresh_Click" Height="40" Background="#333" Foreground="White" Margin="0,0,10,10" BorderThickness="0" Cursor="Hand"/>
				<Button Content="GÉRER UTILISATEURS" Click="BtnUsers_Click" Height="40" Background="Transparent" Foreground="#AAA" Margin="0,0,10,10" BorderThickness="1" BorderBrush="#444" Cursor="Hand"/>
				<Button Content="JOURNAUX / LOGS" Click="BtnLogs_Click" Height="40" Background="Transparent" Foreground="#AAA" Margin="0,0,10,10" BorderThickness="1" BorderBrush="#444" Cursor="Hand"/>
				<Button Content="CONFIGURATION PRIX" Click="BtnConfig_Click" Height="40" Background="Transparent" Foreground="#AAA" Margin="0,0,10,10" BorderThickness="1" BorderBrush="#444" Cursor="Hand"/>
			</StackPanel>

			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Indicateurs Clés (Temps Réel)" Foreground="White" FontSize="16" Margin="0,0,0,20"/>

				<WrapPanel Grid.Row="1">
					<Border Width="200" Height="100" Background="#27AE60" CornerRadius="8" Margin="0,0,20,20">
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
							<TextBlock Text="Recette du Jour" Foreground="White" Opacity="0.8"/>
							<TextBlock x:Name="LblRecetteJour" Text="0 FCFA" Foreground="White" FontWeight="Bold" FontSize="24"/>
						</StackPanel>
					</Border>

					<Border Width="200" Height="100" Background="#2980B9" CornerRadius="8" Margin="0,0,20,20">
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
							<TextBlock Text="En Lavage" Foreground="White" Opacity="0.8"/>
							<TextBlock x:Name="LblEnLavage" Text="0 Tickets" Foreground="White" FontWeight="Bold" FontSize="24"/>
						</StackPanel>
					</Border>

					<Border Width="200" Height="100" Background="#E67E22" CornerRadius="8" Margin="0,0,20,20">
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
							<TextBlock Text="Retards" Foreground="White" Opacity="0.8"/>
							<TextBlock x:Name="LblRetards" Text="0" Foreground="White" FontWeight="Bold" FontSize="24"/>
						</StackPanel>
					</Border>
				</WrapPanel>
			</Grid>
		</Grid>
	</Grid>
</Window>