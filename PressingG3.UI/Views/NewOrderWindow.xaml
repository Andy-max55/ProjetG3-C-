<Window x:Class="PressingG3.UI.Views.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau Dépôt - Enregistrement" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1.5*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" Margin="0,0,20,0">

			<Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="👤 INFORMATIONS CLIENT" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Margin="0,0,10,0">
							<TextBlock Text="Nom Complet :" Foreground="Gray"/>
							<TextBox x:Name="TxtClientName" Height="35" VerticalContentAlignment="Center" Padding="5"/>
						</StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Téléphone :" Foreground="Gray"/>
                            <TextBox x:Name="TxtClientPhone" Height="35" VerticalContentAlignment="Center" Padding="5"/>
                        </StackPanel>


                    </Grid>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Adresse Email (Facultatif) :" Foreground="Gray"/>
                        <TextBox x:Name="TxtClientEmail" Height="35" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>
                </StackPanel>
			</Border>

			<Border Background="White" CornerRadius="8" Padding="15">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="👕 AJOUTER UN ARTICLE" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

					<TextBlock Text="Type de vêtement :" Foreground="Gray"/>
					<ComboBox x:Name="CmbArticleType" Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center">
						<ComboBoxItem Content="Chemise (Classique)" Tag="1000"/>
						<ComboBoxItem Content="Pantalon (Simple)" Tag="1500"/>
						<ComboBoxItem Content="Costume (2 Pièces)" Tag="3500"/>
						<ComboBoxItem Content="Costume (3 Pièces)" Tag="5000"/>
						<ComboBoxItem Content="Robe de soirée" Tag="4000"/>
						<ComboBoxItem Content="Manteau / Veste" Tag="2500"/>
						<ComboBoxItem Content="Couverture / Drap" Tag="3000"/>
					</ComboBox>

					<Grid Margin="0,0,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Margin="0,0,10,0">
							<TextBlock Text="Prix Unitaire (FCFA) :" Foreground="Gray"/>
							<TextBox x:Name="TxtPrice" Text="0" Height="35" VerticalContentAlignment="Center" Padding="5"/>
						</StackPanel>

						<StackPanel Grid.Column="1" Margin="0,0,10,0">
							<TextBlock Text="Quantité :" Foreground="Gray"/>
							<TextBox x:Name="TxtQuantity" Text="1" Height="35" VerticalContentAlignment="Center" Padding="5"/>
						</StackPanel>

						<Button Content="AJOUTER ⬇" Click="BtnAddArticle_Click"
                                Grid.Column="2" VerticalAlignment="Bottom" Height="35" Width="100"
                                Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
					</Grid>

					<TextBlock Text="Remarque (Tache, Déchirure...) :" Foreground="Gray"/>
					<TextBox x:Name="TxtNotes" Height="35" VerticalContentAlignment="Center" Padding="5"/>
				</StackPanel>
			</Border>

		</StackPanel>

		<Border Grid.Column="1" Background="White" CornerRadius="8" Padding="0">
			<Border.Effect>
				<DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
			</Border.Effect>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="50"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="80"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" Background="#2C3E50" CornerRadius="8,8,0,0">
					<TextBlock Text="RÉCAPITULATIF COMMANDE" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
				</Border>

				<ListView x:Name="ListPanier" Grid.Row="1" Margin="10" BorderThickness="0">
					<ListView.View>
						<GridView>
							<GridViewColumn Header="Article" Width="180" DisplayMemberBinding="{Binding Description}"/>
							<GridViewColumn Header="Qté" Width="50" DisplayMemberBinding="{Binding Quantite}"/>
							<GridViewColumn Header="Total" Width="80" DisplayMemberBinding="{Binding TotalLigne}"/>

							<GridViewColumn Header="Actions" Width="100">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<Button Content="✏️" Click="BtnEditRow_Click" Width="30" Height="25" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Modifier"/>
											<Button Content="❌" Click="BtnDeleteRow_Click" Width="30" Height="25" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Red" ToolTip="Supprimer"/>
										</StackPanel>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>

						</GridView>
					</ListView.View>
				</ListView>

				<StackPanel Grid.Row="2" Margin="20,10">
					<Separator Margin="0,0,0,10"/>
					<Grid>
						<TextBlock Text="TOTAL À PAYER :" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
						<TextBlock x:Name="TxtTotalGeneral" Text="0 FCFA" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right"/>
					</Grid>
				</StackPanel>

				<Grid Grid.Row="3" Margin="20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button Content="ANNULER" Click="BtnCancel_Click"
                            Grid.Column="0" Margin="0,0,10,0" Height="45"
                            Background="#95A5A6" Foreground="White" BorderThickness="0"/>

					<Button Content="VALIDER &amp; IMPRIMER" Click="BtnValidate_Click"
                            Grid.Column="1" Height="45"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
						<Button.Effect>
							<DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
						</Button.Effect>
					</Button>
				</Grid>
			</Grid>
		</Border>

	</Grid>
</Window>