<Window x:Class="PressingG3.UI.Views.AdminUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du Personnel" Height="500" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,20,0" Padding="10">
            <DockPanel>
                <TextBlock Text="LISTE DES EMPLOYÉS" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>

                <DataGrid x:Name="GridUsers" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="White" BorderThickness="0" RowHeight="30"
                          SelectionMode="Single" SelectionChanged="GridUsers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Identifiant" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="👤 Fiche Employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

                <TextBlock Text="Identifiant (Login) :" Foreground="Gray"/>
                <TextBox x:Name="TxtUsername" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Mot de Passe :" Foreground="Gray"/>
                <TextBox x:Name="TxtPassword" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Rôle / Poste :" Foreground="Gray"/>
                <ComboBox x:Name="CmbRole" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,20">
                    <ComboBoxItem Content="Administrateur"/>
                    <ComboBoxItem Content="Reception"/>
                    <ComboBoxItem Content="Lavage"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Nouveau" Click="BtnNew_Click" Width="80" Height="35" Margin="0,0,10,0" Background="#ECF0F1" Foreground="Black" BorderThickness="0"/>
                    <Button Content="💾 SAUVEGARDER" Click="BtnSave_Click" Width="130" Height="35" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <Button Content="🗑️ Supprimer ce compte" Click="BtnDelete_Click" 
                        Margin="0,40,0,0" Background="Transparent" Foreground="Red" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>